{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/project-report.config.schema.json",
  "title": "Projektkonfiguration für einen Website-QA-Bericht",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalog",
    "project",
    "selectedModules",
    "technicalRuns"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "website-qa-baseline"
        },
        "version": {
          "const": "1.2.0"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "evaluationEnvironment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preferredUrl": {
          "type": "string",
          "format": "uri"
        },
        "evaluationEnvironment": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "selectedModules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "core"
      },
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceFile": {
      "type": "string",
      "minLength": 1
    },
    "technicalRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reportFile",
          "targetUrl",
          "environment",
          "command"
        ],
        "properties": {
          "reportFile": {
            "type": "string",
            "minLength": 1
          },
          "targetUrl": {
            "type": "string",
            "format": "uri"
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "sourceRevision": {
            "type": "string",
            "minLength": 1
          },
          "deploymentId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "itemStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "status",
          "recordedAt",
          "recordedBy",
          "note"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "notApplicable",
              "external",
              "deferred",
              "acceptedDeviation"
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date"
          },
          "recordedBy": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "responsible": {
            "type": "string",
            "minLength": 1
          },
          "reviewAt": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "external",
                    "deferred",
                    "acceptedDeviation"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "responsible"
              ],
              "properties": {
                "responsible": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "deferred",
                    "acceptedDeviation"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "reviewAt"
              ],
              "properties": {
                "reviewAt": true
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
