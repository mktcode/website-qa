{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/project-report.schema.json",
  "title": "Normalisierter Website-QA-Projektbericht (Ausgabeschema 3)",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "catalog",
    "project",
    "provenance",
    "scope",
    "technicalRuns",
    "records",
    "items",
    "summary",
    "warnings",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status"
      ],
      "properties": {
        "id": {
          "const": "website-qa-baseline"
        },
        "version": {
          "const": "1.2.0"
        },
        "status": {
          "const": "stable"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "evaluationEnvironment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preferredUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "const": "(privates/lokales Ziel)"
            }
          ]
        },
        "evaluationEnvironment": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "deploymentAndSourceContext",
        "targetUrlBinding"
      ],
      "properties": {
        "deploymentAndSourceContext": {
          "const": "projectDeclared"
        },
        "targetUrlBinding": {
          "const": "matchedAgainstRedactedTechnicalReport"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "selectedModules",
        "selectedItemIds"
      ],
      "properties": {
        "selectedModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selectedItemIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "technicalRuns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technicalRun"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^R[0-9]{6}$"
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "type",
        "record"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/recordId"
        },
        "type": {
          "enum": [
            "assertion",
            "evidence"
          ]
        },
        "record": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "assertion"
            },
            "record": {
              "$ref": "#/$defs/assertionRecord"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "evidence"
            },
            "record": {
              "$ref": "#/$defs/evidenceRecord"
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "assertionRecord": {
      "type": "object",
      "required": [
        "assertionId",
        "assertionVersion",
        "tool",
        "outcome",
        "message",
        "subject"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "minLength": 1
        },
        "assertionVersion": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "notApplicable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "object"
        },
        "tool": {
          "enum": [
            "http-check",
            "crawl-check",
            "browser-check",
            "social-preview-check"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "criterionId",
        "outcome",
        "checkedAt",
        "checkedBy",
        "note"
      ],
      "properties": {
        "criterionId": {
          "type": "string",
          "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}/C[1-9][0-9]*$"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "notApplicable"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "checkedBy": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "mode",
        "outcome",
        "recordRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}/C[1-9][0-9]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "automatic",
            "manual",
            "external"
          ]
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "notApplicable",
            "noEvidence"
          ]
        },
        "evidenceClass": {
          "type": "string",
          "minLength": 1
        },
        "evidenceInstructions": {
          "type": "string",
          "minLength": 1
        },
        "requiredAssertionIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recordRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordId"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "automatic"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "requiredAssertionIds": true
            },
            "required": [
              "requiredAssertionIds"
            ]
          },
          "else": {
            "not": {
              "properties": {
                "requiredAssertionIds": true
              },
              "required": [
                "requiredAssertionIds"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "module",
        "statement",
        "evidenceOutcome",
        "projectStatus",
        "criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidenceOutcome": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "open",
            "inconclusive",
            "notApplicable"
          ]
        },
        "projectStatus": {
          "enum": [
            "complete",
            "failed",
            "partial",
            "open",
            "inconclusive",
            "notApplicable",
            "external",
            "deferred",
            "acceptedDeviation"
          ]
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      },
      "additionalProperties": false
    },
    "criterionCounts": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "inconclusive",
        "notApplicable",
        "noEvidence",
        "total"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "noEvidence": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "automaticCriteria",
        "nonAutomaticCriteria",
        "checklistItems"
      ],
      "properties": {
        "automaticCriteria": {
          "$ref": "#/$defs/criterionCounts"
        },
        "nonAutomaticCriteria": {
          "$ref": "#/$defs/criterionCounts"
        },
        "checklistItems": {
          "$ref": "#/$defs/checklistItemCounts"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "itemId",
        "status",
        "recordedAt",
        "recordedBy",
        "note"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$"
        },
        "status": {
          "enum": [
            "notApplicable",
            "external",
            "deferred",
            "acceptedDeviation"
          ]
        },
        "recordedAt": {
          "type": "string",
          "format": "date"
        },
        "recordedBy": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "responsible": {
          "type": "string",
          "minLength": 1
        },
        "reviewAt": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "external",
                  "deferred",
                  "acceptedDeviation"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "responsible"
            ],
            "properties": {
              "responsible": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "deferred",
                  "acceptedDeviation"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewAt"
            ],
            "properties": {
              "reviewAt": true
            }
          }
        }
      ]
    },
    "checklistItemCounts": {
      "type": "object",
      "required": [
        "complete",
        "failed",
        "partial",
        "open",
        "inconclusive",
        "notApplicable",
        "external",
        "deferred",
        "acceptedDeviation",
        "total"
      ],
      "properties": {
        "complete": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "external": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedDeviation": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "technicalRun": {
      "type": "object",
      "required": [
        "tool",
        "toolPackage",
        "generatedAt",
        "targetUrl",
        "environment",
        "command",
        "contextProvenance",
        "assertionCount",
        "usedForEvaluation",
        "summary"
      ],
      "properties": {
        "tool": {
          "enum": [
            "http-check",
            "crawl-check",
            "browser-check",
            "social-preview-check"
          ]
        },
        "toolPackage": {
          "type": "object",
          "required": [
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "targetUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "const": "(privates/lokales Ziel)"
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "reportFile": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1
        },
        "contextProvenance": {
          "type": "object",
          "required": [
            "targetUrl",
            "sourceRevision",
            "deploymentId"
          ],
          "properties": {
            "targetUrl": {
              "const": "matchedAgainstRedactedTechnicalReport"
            },
            "sourceRevision": {
              "const": "projectDeclared"
            },
            "deploymentId": {
              "const": "projectDeclared"
            }
          },
          "additionalProperties": false
        },
        "assertionCount": {
          "type": "integer",
          "minimum": 0
        },
        "usedForEvaluation": {
          "type": "boolean"
        },
        "summary": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
