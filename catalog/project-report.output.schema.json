{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/project-report.output.schema.json",
  "title": "Erzeugter Website-QA-Pilotbericht (Ausgabeschema 2)",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "catalog",
    "project",
    "provenance",
    "scope",
    "technicalRuns",
    "items",
    "summary",
    "warnings",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "catalog": { "$ref": "#/$defs/catalog" },
    "project": {
      "type": "object",
      "required": ["name", "evaluationEnvironment"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "preferredUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "const": "(privates/lokales Ziel)" }
          ]
        },
        "evaluationEnvironment": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["deploymentAndSourceContext", "targetUrlBinding"],
      "properties": {
        "deploymentAndSourceContext": { "const": "projectDeclared" },
        "targetUrlBinding": { "const": "matchedAgainstRedactedTechnicalReport" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["selectedModules", "selectedItemIds"],
      "properties": {
        "selectedModules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "selectedItemIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "technicalRuns": {
      "type": "array",
      "items": { "$ref": "#/$defs/technicalRun" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "catalog": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "const": "website-qa-pilot" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "const": "pilot" }
      },
      "additionalProperties": false
    },
    "technicalRun": {
      "type": "object",
      "required": [
        "tool",
        "toolPackage",
        "generatedAt",
        "targetUrl",
        "environment",
        "command",
        "contextProvenance",
        "assertionCount",
        "usedForEvaluation",
        "summary"
      ],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "toolPackage": {
          "type": "object",
          "required": ["version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "targetUrl": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "const": "(privates/lokales Ziel)" }
          ]
        },
        "environment": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "reportFile": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "deploymentId": { "type": "string", "minLength": 1 },
        "contextProvenance": {
          "type": "object",
          "required": ["targetUrl", "sourceRevision", "deploymentId"],
          "properties": {
            "targetUrl": {
              "enum": ["matchedAgainstRedactedTechnicalReport", "(ungültige URL)"],
              "$comment": "Der zweite Wert bleibt ausschließlich zur Validierung historischer 0.6.x-Berichte erhalten."
            },
            "sourceRevision": { "const": "projectDeclared" },
            "deploymentId": { "const": "projectDeclared" }
          },
          "additionalProperties": false
        },
        "assertionCount": { "type": "integer", "minimum": 0 },
        "usedForEvaluation": { "type": "boolean" },
        "summary": { "type": "object" }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "module", "statement", "evidenceOutcome", "projectStatus", "criteria"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$" },
        "module": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "evidenceOutcome": {
          "enum": ["pass", "fail", "partial", "open", "inconclusive", "notApplicable"]
        },
        "projectStatus": {
          "enum": [
            "complete",
            "failed",
            "partial",
            "open",
            "inconclusive",
            "notApplicable",
            "external",
            "deferred",
            "acceptedDeviation"
          ]
        },
        "workflow": { "$ref": "#/$defs/workflow" },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["itemId", "status", "recordedAt", "recordedBy", "note"],
      "properties": {
        "itemId": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$" },
        "status": { "enum": ["notApplicable", "external", "deferred", "acceptedDeviation"] },
        "recordedAt": { "type": "string", "format": "date" },
        "recordedBy": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "responsible": { "type": "string", "minLength": 1 },
        "reviewAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "statement", "mode", "outcome", "records"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}/C[1-9][0-9]*$" },
        "statement": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["automatic", "manual", "external"] },
        "outcome": { "enum": ["pass", "fail", "inconclusive", "notApplicable", "noEvidence"] },
        "evidenceClass": { "type": "string", "minLength": 1 },
        "evidenceInstructions": { "type": "string", "minLength": 1 },
        "records": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "criterionCounts": {
      "type": "object",
      "required": ["pass", "fail", "partial", "open", "inconclusive", "notApplicable", "noEvidence", "total"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "open": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "noEvidence": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["automaticCriteria", "nonAutomaticCriteria", "checklistItems"],
      "properties": {
        "automaticCriteria": { "$ref": "#/$defs/criterionCounts" },
        "nonAutomaticCriteria": { "$ref": "#/$defs/criterionCounts" },
        "checklistItems": {
          "type": "object",
          "required": [
            "complete",
            "failed",
            "partial",
            "open",
            "inconclusive",
            "notApplicable",
            "external",
            "deferred",
            "acceptedDeviation",
            "total"
          ],
          "properties": {
            "complete": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "partial": { "type": "integer", "minimum": 0 },
            "open": { "type": "integer", "minimum": 0 },
            "inconclusive": { "type": "integer", "minimum": 0 },
            "notApplicable": { "type": "integer", "minimum": 0 },
            "external": { "type": "integer", "minimum": 0 },
            "deferred": { "type": "integer", "minimum": 0 },
            "acceptedDeviation": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
