{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/project-report.bundle-manifest.schema.json",
  "title": "Manifest eines lokalen Website-QA-Berichtsbundles",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "package", "catalog", "files", "technicalRuns"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "package": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@mktcode/website-qa" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "const": "website-qa-baseline" },
        "version": { "const": "1.1.0" },
        "status": { "const": "stable" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["technicalReport", "projectReportJson", "projectReportMarkdown"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "technicalRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "generatedAt", "reportFile", "usedForEvaluation"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "generatedAt": { "type": "string", "format": "date-time" },
          "reportFile": { "type": "string", "pattern": "^\\./technical/[^/]+\\.json$" },
          "usedForEvaluation": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
