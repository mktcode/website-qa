{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/project-evidence.schema.json",
  "title": "Projektnachweise für den Website-QA-Pilotkatalog",
  "type": "object",
  "required": ["schemaVersion", "catalog", "evidence"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "catalog": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterionId", "outcome", "checkedAt", "checkedBy", "note"],
        "properties": {
          "criterionId": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}/C[1-9][0-9]*$" },
          "outcome": { "enum": ["pass", "fail", "inconclusive", "notApplicable"] },
          "checkedAt": { "type": "string", "format": "date" },
          "checkedBy": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "sourceRevision": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
