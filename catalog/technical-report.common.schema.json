{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/technical-report.common.schema.json",
  "title": "Gemeinsamer Kern technischer Website-QA-Berichte",
  "$defs": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "reportedUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "toolPackage": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@mktcode/website-qa" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "checklistReference": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "website-qa-checklist" },
        "version": { "const": "2.0.0" }
      },
      "additionalProperties": false
    },
    "checklistRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{2}$" },
      "uniqueItems": true
    },
    "signal": {
      "type": "object",
      "required": ["id", "signalVersion", "status", "message", "subject", "checklistRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "signalVersion": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["positive", "defect", "inconclusive", "notApplicable"] },
        "message": { "type": "string", "minLength": 1 },
        "subject": { "type": "object" },
        "checklistRefs": { "$ref": "#/$defs/checklistRefs" }
      },
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "required": ["code", "message", "severity", "checklistRefs"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] },
        "checklistRefs": { "$ref": "#/$defs/checklistRefs" },
        "url": { "$ref": "#/$defs/reportedUrl" }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["requestedUrl", "signals", "issues"],
      "properties": {
        "requestedUrl": { "$ref": "#/$defs/reportedUrl" },
        "requestedUrlParameterNames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        },
        "finalUrl": { "$ref": "#/$defs/reportedUrl" },
        "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
      },
      "additionalProperties": true
    },
    "successEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "generatedAt", "tool", "toolPackage", "checklist", "options", "readOnlyGuarantees", "summary"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "generatedAt": { "$ref": "#/$defs/generatedAt" },
        "tool": { "type": "string", "minLength": 1 },
        "toolPackage": { "$ref": "#/$defs/toolPackage" },
        "checklist": { "$ref": "#/$defs/checklistReference" },
        "options": { "type": "object" },
        "readOnlyGuarantees": { "type": "object" },
        "summary": { "type": "object" }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "tool", "error"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "tool": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 },
        "toolPackage": { "$ref": "#/$defs/toolPackage" }
      }
    },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 }
  }
}
