{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/social-report.schema.json",
  "title": "Technischer Bericht von website-qa-social",
  "oneOf": [
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "success": {
      "allOf": [
        {
          "$ref": "technical-report.common.schema.json#/$defs/successEnvelope"
        },
        {
          "type": "object",
          "required": [
            "privateTargetsRedacted",
            "results",
            "robotsPolicyReviewedAt",
            "robotsPolicySourceSummary"
          ],
          "properties": {
            "tool": {
              "const": "social-preview-check"
            },
            "privateTargetsRedacted": {
              "type": "boolean"
            },
            "robotsPolicyReviewedAt": {
              "type": "string",
              "format": "date"
            },
            "robotsPolicySourceSummary": {
              "type": "object",
              "required": [
                "currentOfficial",
                "historicalRedirect",
                "officialContextOnly"
              ],
              "properties": {
                "currentOfficial": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                },
                "historicalRedirect": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                },
                "officialContextOnly": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                }
              },
              "additionalProperties": false
            },
            "options": {
              "type": "object",
              "required": [
                "maxPages",
                "maxRedirects",
                "privateTargetsRedacted",
                "sitemap",
                "strict",
                "timeoutMilliseconds"
              ],
              "properties": {
                "maxPages": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxRedirects": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxSitemaps": {
                  "type": "integer",
                  "minimum": 1
                },
                "privateTargetsRedacted": {
                  "type": "boolean"
                },
                "sitemap": {
                  "type": "boolean"
                },
                "sitemapUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "strict": {
                  "type": "boolean"
                },
                "timeoutMilliseconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "readOnlyGuarantees": {
              "type": "object",
              "required": [
                "browserInteractions",
                "buttonsActivated",
                "formActionsFetched",
                "formsSubmitted",
                "methods"
              ],
              "properties": {
                "browserInteractions": {
                  "const": false
                },
                "buttonsActivated": {
                  "const": false
                },
                "formActionsFetched": {
                  "const": false
                },
                "formsSubmitted": {
                  "const": false
                },
                "methods": {
                  "const": [
                    "GET"
                  ]
                }
              },
              "additionalProperties": true
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "technical-report.common.schema.json#/$defs/result"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "robots": {
                        "type": "object",
                        "properties": {
                          "policies": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "sourceVerification"
                              ],
                              "properties": {
                                "sourceVerification": {
                                  "enum": [
                                    "currentOfficial",
                                    "historicalRedirect",
                                    "officialContextOnly"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "summary": {
              "type": "object",
              "required": [
                "errors",
                "failed",
                "pages",
                "warnings"
              ],
              "properties": {
                "errors": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                },
                "failed": {
                  "type": "boolean"
                },
                "pages": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                },
                "warnings": {
                  "$ref": "technical-report.common.schema.json#/$defs/nonNegativeInteger"
                }
              },
              "additionalProperties": true
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    },
    "error": {
      "allOf": [
        {
          "$ref": "technical-report.common.schema.json#/$defs/errorEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "tool": {
              "const": "social-preview-check"
            },
            "robotsPolicyReviewedAt": {
              "type": "string",
              "format": "date"
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    }
  }
}
