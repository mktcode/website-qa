{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mktcode/website-qa/catalog/website-catalog.schema.json",
  "title": "Website-QA-Prüfkatalog",
  "type": "object",
  "required": ["schemaVersion", "catalogId", "catalogVersion", "status", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pilot", "stable"] },
    "description": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "statement", "criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{2}$" },
          "module": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "statement", "verification"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z]+-[0-9]{2}/C[1-9][0-9]*$" },
                "statement": { "type": "string", "minLength": 1 },
                "verification": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": { "enum": ["automatic", "manual", "external"] },
                    "assertions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
                    "aggregation": { "enum": ["all"] },
                    "evidenceClass": { "enum": ["administrative", "communication", "editorial", "infrastructure-access", "project-review"] },
                    "instructions": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
