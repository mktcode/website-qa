{
  "name": "@mktcode/website-qa",
  "version": "2.0.1",
  "description": "Read-only technical signals and a comprehensive manual checklist for website quality assurance",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19 <23 || >=24.11 <25"
  },
  "bin": {
    "website-qa-browser": "./src/check-browser.mjs",
    "website-qa-crawl": "./src/check-crawl.mjs",
    "website-qa-http": "./src/check-http.mjs",
    "website-qa-social": "./src/check-social-preview.mjs",
    "website-qa-lighthouse": "./src/check-lighthouse.mjs"
  },
  "exports": {
    "./checklist-index.json": "./catalog/checklist-index.json",
    "./signals.json": "./catalog/signals.json",
    "./technical-report.schema.json": "./catalog/technical-report.schema.json",
    "./technical-report.common.schema.json": "./catalog/technical-report.common.schema.json",
    "./http-report.schema.json": "./catalog/http-report.schema.json",
    "./crawl-report.schema.json": "./catalog/crawl-report.schema.json",
    "./browser-report.schema.json": "./catalog/browser-report.schema.json",
    "./social-report.schema.json": "./catalog/social-report.schema.json",
    "./lighthouse-report.schema.json": "./catalog/lighthouse-report.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "catalog/*.json",
    "CHANGELOG.md",
    "docs",
    "examples",
    "PLANNING.md",
    "src"
  ],
  "scripts": {
    "lint": "oxlint --deny-warnings -D correctness -D suspicious -D perf src tests && eslint --max-warnings 0 src tests",
    "test": "vitest run",
    "test:chromium": "WEBSITE_QA_REQUIRE_CHROMIUM=1 vitest run tests/browser-check.test.ts tests/lighthouse-check.test.ts",
    "test:package": "node tests/package-install.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mktcode/website-qa.git"
  },
  "bugs": {
    "url": "https://github.com/mktcode/website-qa/issues"
  },
  "homepage": "https://github.com/mktcode/website-qa#readme",
  "keywords": [
    "accessibility",
    "axe-core",
    "checklist",
    "crawler",
    "lighthouse",
    "quality-assurance",
    "read-only",
    "technical-signals",
    "website"
  ],
  "dependencies": {
    "axe-core": "4.13.0",
    "fast-xml-parser": "5.11.0",
    "file-type": "22.0.1",
    "lighthouse": "13.4.1",
    "parse5": "8.0.0",
    "puppeteer-core": "25.8.0",
    "robots-parser": "3.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.1",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
